  "mentalModel": {
    "summary": "People differ in six broad tendencies across situations, including how fair and modest they tend to be; these are measured, not diagnosed.",
    "assumptions": [
      "tendencies are continuous, not types",
      "scores are relative to a norm group",
      "the six dimensions are not the five Big Five dimensions with one added; several are defined differently"
    ],
    "stance": "descriptive and comparative",
    "unitOfAnalysis": "the person's typical tendencies over years",
    "attendsTo": [
      "typical tendencies across settings",
      "fairness and modesty in how the person acts",
      "differences from a reference population",
      "fit with recent episodes"
    ],
    "howChangeHappens": "Slowly, mostly across years.",
    "languageGuidance": "Speak of tendencies and ranges, never of moral verdicts; a low Honesty-Humility score is never a judgement of character.",
    "agentPosture": {
      "do": [
        "show raw score, range and norm group together",
        "ask where the score does not fit"
      ],
      "dont": [
        "treat Honesty-Humility as a measure of trustworthiness",
        "translate HEXACO scores into Big Five scores"
      ]
    },
    "exploratoryQuestions": [
      "Where do you recognise fairness and modesty in how you act?",
      "Where does the score not fit your experience?"
    ],
    "helperMustNot": [
      "present a score as evidence of fit for a job or role",
      "comment on Honesty-Humility to anyone but the person",
      "comment on the Anxiety or Fearfulness facets unless the person raises them"
    ],
    "doesNotClaim": [
      "anything about a single moment",
      "moral character",
      "clinical states",
      "suitability for a job"
    ],
    "riskNotes": [
      "Honesty-Humility is a moralised trait; disclosure in work settings risks reputational harm",
      "Emotionality facets named Anxiety and Fearfulness read as health information"
    ]
  },
