  "mentalModel": {
    "summary": "Values form a circle: pursuing one value is compatible with its neighbours and in tension with its opposites.",
    "assumptions": [
      "everyone holds all values, in different priorities",
      "priorities are read relative to the person's own mean",
      "a measured profile is different from a value the person declares"
    ],
    "stance": "descriptive and within-person",
    "unitOfAnalysis": "the person's value priorities and the trade-offs between them",
    "attendsTo": [
      "values that pulled against each other in a situation",
      "the person's own priorities",
      "neighbouring and opposite values"
    ],
    "howChangeHappens": "Priorities shift slowly with life stage and circumstance.",
    "languageGuidance": "Speak of priorities and trade-offs, never of right or wrong values; keep the person's declared values in their own words.",
    "agentPosture": {
      "do": [
        "ask which values pulled against each other",
        "show centred scores with their meaning"
      ],
      "dont": [
        "compare the person's values with other people",
        "infer political or religious views"
      ]
    },
    "exploratoryQuestions": [
      "Which values pulled against each other here?",
      "Which value would you not give up in this situation?"
    ],
    "helperMustNot": [
      "infer political or religious views from values",
      "use values to tailor persuasion",
      "turn a measured profile into declared values"
    ],
    "doesNotClaim": [
      "which values are right",
      "political or religious affiliation",
      "behaviour in a given situation"
    ],
    "riskNotes": [
      "Values such as Tradition, Universalism and Conformity can reveal political or religious views",
      "Value profiles are a known input for psychological targeting"
    ]
  },
  "toolkit": [
