  "title": {
    "en": "Interpretation vocabularies",
    "ru": "Словари интерпретаций"
  },
  "description": {
    "en": "Vocabularies for readings of experience: the stance of a reading, its causal claim, the kinds of grounds and the kinds of alternative explanations.",
    "ru": "Словари для прочтений опыта: позиция прочтения, его причинное утверждение, виды оснований и виды альтернативных объяснений."
  },
  "closed": true,
  "lists": [
    {
      "name": "stances",
      "title": {
        "en": "Stances",
        "ru": "Позиции прочтения"
      },
      "closed": true,
      "field": "Interpretation.stance"
    },
    {
      "name": "causal",
      "title": {
        "en": "Causal claims",
        "ru": "Причинные утверждения"
      },
      "closed": true,
      "field": "Interpretation.causal"
    },
    {
      "name": "ground-kinds",
      "title": {
        "en": "Ground kinds",
        "ru": "Виды оснований"
      },
      "closed": true,
      "field": "Ground.kind"
    },
    {
      "name": "alternative-kinds",
      "title": {
        "en": "Alternative kinds",
        "ru": "Виды альтернатив"
      },
      "closed": true,
      "field": "Alternative.kind",
      "notes": "I4 and RC-4 require at least one alternative that is not psychological."
    }
  ],
  "codes": [
    {
