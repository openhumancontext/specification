        "en": "Account kinds",
        "ru": "Виды рассказов"
      },
      "closed": true,
      "field": "Account.accountKind"
    },
    {
      "name": "confirmation",
      "title": {
        "en": "External confirmation",
        "ru": "Внешнее подтверждение"
      },
      "closed": true,
      "field": "Episode.externalConfirmation.status"
    },
    {
      "name": "recall",
      "title": {
        "en": "Recall permission",
        "ru": "Разрешение на возвращение опыта"
      },
      "closed": true,
      "field": "Episode.recall",
      "notes": "Only the subject sets or changes it, through relax or restrict Reviews."
    },
    {
      "name": "selection-reasons",
      "title": {
        "en": "Selection reasons",
        "ru": "Причины выбора"
