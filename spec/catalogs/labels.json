  "title": {
    "en": "Derived display labels",
    "ru": "Производные метки"
  },
  "description": {
    "en": "One display label per record, computed from the status axes. The first matching rule (lowest precedence) wins. Labels are always rendered as glyph plus word; colour is never the only carrier.",
    "ru": "Одна метка для показа на запись, вычисляемая из осей статуса. Побеждает первое совпавшее правило (наименьший precedence). Метка всегда показывается значком и словом; цвет никогда не бывает единственным носителем смысла."
  },
  "closed": true,
  "ordered": true,
  "codes": [
    {
      "code": "not-accepted",
      "label": {
        "en": "not accepted",
        "ru": "не принято"
      },
      "definition": {
        "en": "Admission is `declined` or `retracted`. Not served to grantees.",
        "ru": "Принятие — `declined` или `retracted`. Получателям не показывается."
      },
      "glyph": "—",
      "precedence": 0
    },
    {
      "code": "disputed",
      "label": {
        "en": "disputed",
        "ru": "оспорено"
      },
      "definition": {
        "en": "Endorsement is `rejected`, or the `contested` flag is set.",
        "ru": "Позиция человека — `rejected`, или установлен признак `contested`."
      },
      "glyph": "⊘",
      "precedence": 1,
      "mappings": {
        "ode": "disputed"
      }
    },
    {
      "code": "stale",
      "label": {
        "en": "stale",
        "ru": "устарело"
      },
      "definition": {
        "en": "Freshness is `review-due`, `expired` or `unknown`.",
        "ru": "Свежесть — `review-due`, `expired` или `unknown`."
      },
      "glyph": "○",
      "precedence": 2,
      "mappings": {
        "ode": "stale"
      }
    },
    {
      "code": "pending",
      "label": {
        "en": "pending",
        "ru": "ожидает решения"
