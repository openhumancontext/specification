{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohc:schema:msg-use-report:0.1.0-draft",
  "title": "OHC use-report message",
  "description": "EXPERIMENTAL. Agent to holder: shows the person which items informed which decision.",
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "id",
    "from",
    "to",
    "at",
    "grant",
    "purpose",
    "projection",
    "usedRecords"
  ],
  "properties": {
    "format": {
      "const": "ohc.experimental.use-report"
    },
    "specVersion": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/specVersion"
    },
    "id": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/id"
    },
    "from": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/from"
    },
    "to": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/to"
    },
    "at": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/at"
    },
    "inReplyTo": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/inReplyTo"
    },
    "grant": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
    },
    "purpose": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/purposes"
    },
    "projection": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
    },
    "projectionDigest": {
      "description": "The digest of the projection used (run-time evidence for an ODE binding).",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Digest"
    },
    "checkedAt": {
      "description": "When the grant was last checked before use (C-1, R-G6).",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/DateTime"
    },
    "usedRecords": {
      "type": "array",
      "items": {
        "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
      }
    },
    "decisionRef": {
      "description": "An ODE Decision.",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/OdeRef"
    },
    "note": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    }
  },
  "additionalProperties": false
}
