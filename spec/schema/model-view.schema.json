{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohc:schema:model-view:0.1.0-draft",
  "title": "OHC ModelView",
  "description": "One named model's view over a set of episodes and evidence: the hypotheses it produced, its question, grounds, limits and alternative views. Adds no new statements (MV-2). Layer interpretation; module lenses.",
  "type": "object",
  "required": [
    "id",
    "scope",
    "hypotheses",
    "origin",
    "assertedBy",
    "recordedAt"
  ],
  "properties": {
    "kind": {
      "const": "ModelView"
    },
    "id": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/id"
    },
    "lens": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LensRef"
    },
    "model": {
      "type": "object",
      "description": "For models not in the registry.",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
        },
        "version": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
        }
      },
      "additionalProperties": false
    },
    "adoption": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
    },
    "question": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    },
    "scope": {
      "type": "object",
      "properties": {
        "episodes": {
          "type": "array",
          "items": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
          },
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
          },
          "minItems": 1
        },
        "period": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Interval"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "episodes"
          ]
        },
        {
          "required": [
            "sources"
          ]
        }
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
      },
      "minItems": 1
    },
    "representation": {
      "description": "A lens representation id.",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    },
    "summary": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    },
    "grounds": {
      "type": "array",
      "items": {
        "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Ground"
      }
    },
    "limits": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Ref"
          },
          {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/URI"
          }
        ]
      }
    },
    "origin": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/origin"
    },
    "assertedBy": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/assertedBy"
    },
    "recordedAt": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/recordedAt"
    },
    "recordedBy": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/recordedBy"
    },
    "underGrant": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/underGrant"
    },
    "purpose": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/purpose"
    },
    "formulatedAt": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/formulatedAt"
    },
    "supersedes": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/supersedes"
    },
    "epistemic": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/epistemic"
    },
    "confidence": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/confidence"
    },
    "sensitivity": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/sensitivity"
    },
    "categories": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/categories"
    },
    "handling": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/handling"
    },
    "audience": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/audience"
    },
    "contexts": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/contexts"
    },
    "lang": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/lang"
    },
    "importedFrom": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/importedFrom"
    },
    "generatedBy": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/generatedBy"
    },
    "derivedFrom": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/derivedFrom"
    },
    "synthetic": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/synthetic"
    },
    "note": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/note"
    },
    "ext": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Envelope/properties/ext"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/EnvelopeRules"
    },
    {
      "oneOf": [
        {
          "required": [
            "lens"
          ]
        },
        {
          "required": [
            "model"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "assertedBy": {
            "not": {
              "const": "subject"
            }
          }
        },
        "required": [
          "assertedBy"
        ]
      },
      "then": {
        "required": [
          "grounds",
          "limits",
          "alternatives"
        ],
        "properties": {
          "grounds": {
            "minItems": 1
          },
          "alternatives": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
