{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohc:schema:msg-erasure-notice:0.1.0-draft",
  "title": "OHC erasure-notice message",
  "description": "EXPERIMENTAL. Holder to agent: records were erased; the recipient MUST purge them by purgeBy (default erasedAt + P7D) and acknowledge.",
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "id",
    "from",
    "to",
    "at",
    "records",
    "erasedAt",
    "purgeBy"
  ],
  "properties": {
    "format": {
      "const": "ohc.experimental.erasure-notice"
    },
    "specVersion": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/specVersion"
    },
    "id": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/id"
    },
    "from": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/from"
    },
    "to": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/to"
    },
    "at": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/at"
    },
    "inReplyTo": {
      "$ref": "urn:ohc:schema:message:0.1.0-draft#/properties/inReplyTo"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
      },
      "minItems": 1
    },
    "erasedAt": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/DateTime"
    },
    "purgeBy": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/DateTime"
    }
  },
  "additionalProperties": false
}
