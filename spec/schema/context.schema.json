{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohc:schema:context:0.1.0-draft",
  "title": "OHC Context",
  "description": "The root document of a context (manifest): the subject, parties, stewards, holder, declared conformance and record collections. One schema covers both serializations: the package form (collections, no record arrays) and the single-document form (record arrays). Layer subject; module core.",
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "id",
    "version",
    "subject"
  ],
  "properties": {
    "format": {
      "const": "ohc.context"
    },
    "specVersion": {
      "const": "0.1.0-draft"
    },
    "id": {
      "description": "A URI the holder controls: urn:uuid (recommended), a DID, or urn:ohc:example:<person>[:context] in examples.",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/URI"
    },
    "version": {
      "description": "Chosen by the holder; changes with every change set.",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
    },
    "subject": {
      "$ref": "urn:ohc:schema:subject:0.1.0-draft"
    },
    "holder": {
      "description": "Default \"subject\".",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Actor"
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "urn:ohc:schema:party:0.1.0-draft"
      }
    },
    "stewards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Steward"
      }
    },
    "conformance": {
      "type": "object",
      "description": "Declared conformance (R-C1). Default L0 with core.",
      "properties": {
        "level": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/conformance-levels"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/modules"
          },
          "minItems": 1
        },
        "subjectIsAdult": {
          "description": "The holder's attestation that the subject is an adult who decides for themselves (R-C4). A context about a child, or about an adult whose decisions are made by a guardian, cannot claim conformance in 0.1.",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "lang": {
      "description": "Default en.",
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LangTag"
    },
    "created": {
      "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/DateTime"
    },
    "policy": {
      "type": "object",
      "description": "Default admission subject-only; default resolver returnDialog.",
      "properties": {
        "admission": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/admission-policies"
        },
        "retention": {
          "type": "object",
          "properties": {
            "sourcesDefault": {
              "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Duration"
            }
          },
          "additionalProperties": false
        },
        "resolver": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/grant.resolvers"
        }
      },
      "additionalProperties": false
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/URI"
          },
          "version": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
          },
          "sha256": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Sha256Hex"
          },
          "descriptor": {
            "description": "An inline local lens descriptor (single-document form only; a package ships it in lenses/). Local descriptors use an x- namespace in the lens id and the light profile of LENSES.md §5.1.",
            "$ref": "urn:ohc:schema:lens:0.1.0-draft"
          }
        },
        "additionalProperties": false
      },
      "description": "Pins of the lens descriptor versions this context uses. A pin without a resolvable descriptor is treated as a stub (LA-6, W-LA6)."
    },
    "playbooks": {
      "type": "array",
      "description": "Pins of the playbooks this context uses (LENSES.md §2.2). A single document MAY carry a local playbook inline (playbook); a package ships it in lenses/. A pin that resolves to no playbook is left out of the agent rendering (W-PB5).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^urn:ohc:playbook:(?:x-[a-z0-9]+(?:[.-][a-z0-9]+)*:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
          },
          "sha256": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Sha256Hex"
          },
          "playbook": {
            "description": "An inline local playbook (single-document form only; a package ships it in lenses/).",
            "$ref": "urn:ohc:schema:playbook:0.1.0-draft"
          }
        },
        "additionalProperties": false
      }
    },
    "vocabulary": {
      "description": "Definitions of local x- codes.",
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalCode"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "definition"
        ],
        "properties": {
          "definition": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
          },
          "broader": {
            "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/Text"
          }
        },
        "additionalProperties": false
      }
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "minItems": 1
    },
    "collections": {
      "type": "object",
