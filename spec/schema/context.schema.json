  "$defs": {
    "Steward": {
      "type": "object",
      "description": "A steward never acts on special-tier or inner-system records (R-A1) and never endorses beyond scope (ST-1).",
      "required": [
        "party",
        "scope",
        "basis",
        "validFrom",
        "validUntil",
        "expressedBy"
      ],
      "properties": {
        "party": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/LocalId"
        },
        "scope": {
          "type": "object",
          "description": "Review actions the steward may take (§11.1), plus write and infer for records the steward writes itself (INF-1), grant to issue grants (GR-8), and open-verbatim to confirm step-ups (SU-2).",
          "required": [
            "actions"
          ],
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/record-kinds"
              },
              "minItems": 1
            },
            "facets": {
              "type": "array",
              "items": {
                "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/claim-facets.facets"
              },
              "minItems": 1
            },
            "actions": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/review-actions"
                  },
                  {
                    "enum": [
                      "write",
                      "infer",
                      "grant",
                      "open-verbatim"
                    ]
                  }
                ]
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "basis": {
          "$ref": "urn:ohc:schema:common:0.1.0-draft#/$defs/steward-basis"
        },
        "validFrom": {
